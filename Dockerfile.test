# Test runner: Home Assistant doesn't run on Windows, so tests run in Linux.
#   docker build -f Dockerfile.test -t openrouter-credits-test .
#   docker run --rm -v "${PWD}:/src:ro" openrouter-credits-test
FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim

COPY requirements_test.txt /tmp/requirements_test.txt
RUN uv pip install --system -r /tmp/requirements_test.txt

ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /src
ENTRYPOINT ["python", "-m", "pytest", "-p", "no:cacheprovider"]
CMD ["-q"]
